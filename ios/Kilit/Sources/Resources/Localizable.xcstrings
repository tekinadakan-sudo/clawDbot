    "onboarding.passcode.body": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilit, anahtarları ve mesajları cihaz parolasıyla korunan depoda tutar. Parolası olmayan cihazlarda anlamlı bir veri koruması yoktur; kayıt bu cihazlarda reddedilir. Ayarlar › Face ID ve Parola bölümünden bir parola belirle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilit keeps keys and messages in storage protected by the device passcode. Devices without a passcode have no meaningful at-rest protection; registration is refused on them. Set a passcode under Settings › Face ID & Passcode."
          }
        }
      }
    },
