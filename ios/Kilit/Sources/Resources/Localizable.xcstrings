    "onboarding.welcome": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uçtan uca şifreli, ekran yakalamaya karşı sertleştirilmiş birebir mesajlaşma. Devam etmeden önce birkaç şeyi bilmen gerekir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End-to-end encrypted 1:1 messaging, hardened against screen capture. There are a few things to know before you continue."
          }
        }
      }
    },
    "photosensitivity.body": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Titreşim Kalkanı mesaj içeriğinin üzerinde iki ince desen arasında saniyede 120 kez geçiş yapar (saniyede 60 tam döngü). Hızla yanıp sönen görüntüler fotosensitif epilepsisi olan kişilerde nöbeti tetikleyebilir; diğer kişilerde göz yorgunluğu, baş ağrısı, baş dönmesi veya bulantıya yol açabilir. Sizde ya da ekranınızı görebilecek birinde nöbet geçmişi varsa bu özelliği açmayın. Kendinizi kötü hissederseniz hemen kapatın. Bu deneysel bir caydırıcıdır; ekranınızın fotoğraflanmasını veya kaydedilmesini engellemez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flicker Shield rapidly alternates between two fine patterns over message content (120 changes per second, 60 full cycles). Rapidly flashing or flickering images can trigger seizures in people with photosensitive epilepsy and can cause eye strain, headaches, dizziness or nausea in others. Do not turn this on if you, or anyone who may see your screen, has a history of seizures. Stop and turn it off immediately if you feel unwell. This is an experimental deterrent only; it does not prevent someone from photographing or recording your screen."
          }
        }
      }
    },
    "photosensitivity.keep_off": {
      "extractionState": "manual",
