        }
      }
    },
    "keychange.verify": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenlik numarasını göster"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show safety number"
          }
        }
      }
    },
    "limits.1": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekrana tutulan ikinci bir kamera engellenemez. Filigran kimlik tespiti sağlar, titreşim caydırıcıdır, basılı tutarak gösterme açıkta kalan alanı küçültür. \"Kaydedilemez\" demiyoruz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A second camera pointed at the screen cannot be prevented. The watermark gives attribution, the flicker is a deterrent, hold-to-reveal shrinks the exposed surface. Never say \"cannot be recorded\"."
          }
        }
      }
    },
    "limits.10": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grup, ses, video, çoklu cihaz, hesap kurtarma (yeni telefon = yeni kimlik = \"güvenlik numarası değişti\"), bildirim içeriği yok. Mesajlar uygulama açıkken gelir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No groups, audio, video, multi-device, account recovery (new phone = new identity = \"safety number changed\"), push content, or Notification Service Extension. APNs sending is a phase-2 hook; messages arrive when the app is foregrounded."
          }
        }
      }
    },
    "limits.2": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran görüntüsü/kayıt karartması, iOS'un belgelenmemiş bir davranışına dayanır; bayrakla korunur, sürekli denetlenir ve gelecekte çalışmayabilir. Sonradan algılama garanti edilen taban çizgisidir. Yazdığın ama göndermediğin taslak karartılmaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshot/recording blanking relies on an undocumented UIKit rendering side effect of isSecureTextEntry; it uses only public calls, is feature-flagged, canary-checked, and may stop working on a future iOS. Detection after the fact is the guaranteed floor. Your own unsent draft in the composer is not blanked (deliberate trade-off); it is covered only by the App Switcher privacy cover."
          }
        }
      }
    },
    "limits.3": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran görüntüsü bildirimi görüntü kaydedildikten sonra gelir; kayıt başladıktan sonraki ilk kareler yakalanabilir; macOS iPhone Yansıtma her iki mekanizmayı da atlayabilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "userDidTakeScreenshotNotification posts after the PNG exists; the first frames after a recording starts may be captured before isSceneCaptured flips; macOS iPhone Mirroring (reported on iOS 26) bypasses both mechanisms."
          }
        }
      }
    },
    "limits.4": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jailbreak'li ya da değiştirilmiş bir karşı taraf uygulaması süreleri yok sayabilir, bildirimleri bastırabilir ve içeriği saklayabilir. Ekranda \"bildirilmedi\" yazar, \"alınmadı\" değil."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A jailbroken or modified peer client can ignore timers, suppress capture reports and keep plaintext. UI wording is \"no screenshot was reported\", never \"none was taken\"."
          }
        }
      }
    },
    "limits.5": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu ve ağ, kimin kiminle ne zaman ve ne büyüklükte konuştuğunu, oturum kurulumlarını ve mesaj sayaçlarını görür."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server and network see metadata (who, when, sizes, session-establishment events and message counters)."
          }
        }
      }
    },
    "limits.6": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parolası olmayan cihazlarda anlamlı bir veri koruması yoktur; kayıt bu cihazlarda reddedilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Devices without a passcode have no meaningful at-rest protection; registration is refused on them."
          }
        }
      }
    },
    "limits.7": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Titreşim panel yenileme hızını aşamaz; 1/60 s ve üzeri pozlama, iki kareli seri çekim ya da video içeriği geri getirir; 60 Hz panellerde kapalıdır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flicker cannot exceed the panel refresh rate; any exposure ≥ 1/60 s, a two-frame burst or video reconstructs the content; it is disabled on 60 Hz panels."
          }
        }
      }
    },
    "limits.8": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birebir sohbette iki taraf da diğerinin filigran etiketini hesaplayabilir; filigran kanıt değil, ipucudur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In a 1:1 chat either party can compute the other's watermark tag, so the mark is evidence, not proof."
          }
        }
      }
    },
    "limits.9": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOver / Ekranı Seslendir içeriği sesli okur ve herhangi bir mikrofonla kaydedilebilir; isteğe bağlı bir ayar erişilebilirlik pahasına içeriği gizler."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOver / Speak Screen read protected content aloud and can be recorded with any microphone; an optional setting hides protected content from assistive technologies at the cost of accessibility."
          }
        }
      }
    },
    "lock.reason": {
