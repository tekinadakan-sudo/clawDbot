      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran paylaşılıyor — kayıt, AirPlay veya uzaktan kontrol etkin; içerik gizlendi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen is being shared — recording, AirPlay or remote control is active; content is hidden."
