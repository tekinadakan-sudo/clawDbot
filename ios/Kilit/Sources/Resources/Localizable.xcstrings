    "onboarding.account.footer": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu adresi kayıttan sonra değiştirilemez (yalnızca \"Hesabı sil ve sıfırla\" ile). Kullanıcı adı: küçük harf, rakam, alt çizgi; 3–32 karakter. Anahtarları kaybolan bir kullanıcı adı sahibi tarafından geri alınamaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server address cannot be changed after registration (only through \"Delete account and reset\"). Username: lowercase letters, digits, underscore; 3–32 characters. A username whose keys are lost cannot be recovered by its owner."
          }
        }
      }
    },
    "onboarding.account.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account"
          }
        }
      }
    },
    "onboarding.bad_server": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçersiz sunucu adresi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid server address"
          }
        }
      }
    },
    "onboarding.bad_username": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
