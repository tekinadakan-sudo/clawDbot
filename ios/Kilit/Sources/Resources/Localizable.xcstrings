          }
        }
      }
    },
    "auth.invalid": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum geçersiz; sunucu bu cihazı tanımıyor. Hesabı sil ve sıfırla gerekebilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Session invalid; the server no longer recognises this device. \"Delete account and reset\" may be required."
          }
        }
      }
    },
    "badge.amber": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca algılama — bu cihazda karartma kullanılamıyor; ekran görüntüleri sonradan algılanır ve bildirilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detection only — blanking is unavailable on this device; screenshots are detected and reported after the fact."
          }
        }
      }
    },
    "badge.amber.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca algılama"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detection only"
          }
        }
      }
    },
    "badge.green": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karartma + algılama — ekran görüntüsü ve kayıt karartılır, ayrıca algılanır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanking + detection — screenshots and recordings are blanked and also detected."
          }
        }
      }
    },
    "badge.green.title": {
      "extractionState": "manual",
