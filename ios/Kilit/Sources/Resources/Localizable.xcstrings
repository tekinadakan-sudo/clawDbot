    "keychange.banner": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenlik numarası değişti. %@ yeni bir cihaz ya da kimlik kullanıyor olabilir. Göndermeden önce doğrulayın."
          }
        },
        "en": {
