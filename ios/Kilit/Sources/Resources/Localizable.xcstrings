{
  "sourceLanguage": "tr",
  "version": "1.0",
  "strings": {
    "a11y.hide.body": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ayar korumalı mesaj ve fotoğrafları VoiceOver, Ekranı Seslendir ve diğer yardımcı teknolojilerden gizler. VoiceOver kullanıyorsanız mesajları okuyamazsınız. Sesli okumanın bir mikrofonla kaydedilmesini zorlaştırır; başka bir koruma sağlamaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This setting hides protected messages and photos from VoiceOver, Speak Screen and other assistive technologies. If you use VoiceOver you will not be able to read messages. It makes recording spoken content with a microphone harder; it provides no other protection."
          }
        }
      }
    },
    "a11y.hide.cancel": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vazgeç"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        }
      }
    },
    "a11y.hide.confirm": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizle"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide"
          }
        }
      }
    },
    "attachment.expired": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ek süresi doldu"
          }
        },
        "en": {
          "stringUnit": {
